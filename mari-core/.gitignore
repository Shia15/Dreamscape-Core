# Existing patterns preserved...
# Node modules
node_modules/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build output
dist/
dist-ssr/
/dist/
/build/
/out/

# Vite cache
.vite/

# TypeScript output
*.js
*.js.map
# Keep workspace tools
!tools/workspace/*.js

# Environment variables
.env
.env.local
.env.*.local

# System files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor directories and files
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# macOS folder metadata
__MACOSX/
.vercel
.AppleDouble
.LSOverride

# Temporary test files or cache
*.tsbuildinfo
coverage/
.cache/

# Optional: Ignore zip bundles
*.zip

# Optional: Ignore Markdown drafts
*.draft.md

# Workspace temporary files
/tmp/
.tmp/

# Monorepo specific ignores
workspace/config/local-*.json
workspace/**/.env.local

# Dependency lockfiles if using a single root lockfile
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml
!package-lock.json
!yarn.lock
!pnpm-lock.yaml

# Ignore cloned repos that are not in Git submodules
/workspace/repos/**/.git
/workspace/repos/**/node_modules/
